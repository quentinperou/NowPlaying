<Window x:Class="NowPlaying.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NowPlaying.Controls"
        Title="NowPlaying Floating"
        WindowStyle="None" Background="Transparent" ThemeMode="None"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False">
  <!-- The floating widget: anywhere on the screen, above the other windows, never activated. Transparent through DWM
       like the taskbar widget (Services/SeeThrough.cs). Its title differs from "NowPlaying" for the installer's
       WM_CLOSE, as the taskbar widget's. -->

  <controls:WidgetView x:Name="View" />
</Window>
