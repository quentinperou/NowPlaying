<!--
  The menus of the notification icon and of the widgets, drawn as those of the Windows 11 taskbar, in the mode of
  Windows (light or dark, as the taskbar): PopupMenu sets the Menu* brushes. Not the Fluent theme of the app window,
  which follows the app's own theme and is not loaded in the widget process.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Its margin leaves room for the shadow (PopupMenu offsets the menu by as much). -->
  <Style x:Key="WindowsMenu" TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Grid Margin="12">
            <!-- The shadow on a shape of its own: an effect on the content would blur its text. -->
            <Border Background="{DynamicResource MenuSurface}" CornerRadius="8">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.2" Color="Black" />
              </Border.Effect>
            </Border>
            <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1"
                    CornerRadius="8" Padding="4,3">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An item: icon (or check mark), text, and on the right a detail (the title playing in a player). -->
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Back" Background="Transparent" CornerRadius="4" MinHeight="34" Margin="0,1" Padding="10,0,12,0"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
              <TextBlock x:Name="Detail" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="12"
                         Foreground="{DynamicResource MenuTextSecondary}" Margin="24,0,0,0" MaxWidth="240"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
              <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource MenuHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MenuTextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="-4,4" Background="{DynamicResource MenuDivider}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
