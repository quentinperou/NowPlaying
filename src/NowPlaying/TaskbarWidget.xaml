<Window x:Class="NowPlaying.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NowPlaying.Controls"
        Title="NowPlaying Widget"
        WindowStyle="None" Background="Transparent" ThemeMode="None"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False">
  <!-- A borderless, transparent window over the taskbar, never activated: the widget. Its title differs from
       "NowPlaying" so that the installer's WM_CLOSE goes to the hidden window that quits the app. Transparent through
       DWM (see TaskbarWidget.xaml.cs), not AllowsTransparency: WPF then draws it with the graphics card.
       ThemeMode="None": the Fluent theme of the app window must not paint it (it gave it a dark Mica background). -->

  <controls:WidgetView x:Name="View" />
</Window>
