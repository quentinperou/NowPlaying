<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store version of NowPlaying: a full MSIX package of the same app, built by scripts\build-store.ps1
  next to the installer of the GitHub version (which this package does not change).

  Identity: the values of the product "NowPlaying by QuentinPerou" in Partner Center (Product identity page), reserved
  on October 24, 2026. The package is not signed: the Store signs it when it publishes it.
  Version: written by the build script from Directory.Build.props (0.3.2 gives 0.3.2.0, the Store wants the last
  number at 0).

  One application (the Store takes no package with several): NowPlaying, with its startup task and the provider of the
  widget of the Windows Widgets board, NowPlaying.Widgets.exe, which Windows starts as a COM server. Its class id is
  not the one of the GitHub version's sparse package, so that both versions can be installed on one PC.

  runFullTrust: a desktop app (the media sessions of every app, its widget placed over the taskbar).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop com rescap">

  <Identity
    Name="QuentinPerou.NowPlayingbyQuentinPerou"
    Publisher="CN=E4BBF1EB-8886-49FD-8647-36786CAF5AC5"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NowPlaying by QuentinPerou</DisplayName>
    <PublisherDisplayName>QuentinPerou</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="NowPlaying.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NowPlaying"
        Description="What's playing, in the Windows 11 taskbar, from any app"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Start with Windows, on from the first launch as the GitHub version does; the user turns it off in the app,
             Task Manager or Settings (Services\AppPackage.cs). -->
        <desktop:Extension Category="windows.startupTask" Executable="NowPlaying.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NowPlayingStartup" Enabled="true" DisplayName="NowPlaying" />
        </desktop:Extension>

        <!-- The provider: NowPlaying.Widgets.exe, started by Windows when a NowPlaying widget is on the board. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="NowPlaying.Widgets.exe" Arguments="-RegisterProcessAsComServer" DisplayName="NowPlaying widget">
              <com:Class Id="FD626078-0E6B-4C13-8494-3A132E92C261" DisplayName="NowPlaying widget" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- The widget, as the board lists it ("+" > NowPlaying). Same as in src\NowPlaying.Widgets\package. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="NowPlaying" Id="NowPlaying">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\Widget.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="FD626078-0E6B-4C13-8494-3A132E92C261" />
                </Activation>
                <Definitions>
                  <Definition Id="NowPlaying" DisplayName="NowPlaying" Description="What's playing, from any app" IsCustomizable="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Widget.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Screenshot-dark.png" DisplayAltText="NowPlaying" />
                      </Screenshots>
                      <DarkMode>
                        <Screenshots>
                          <Screenshot Path="Assets\Screenshot-dark.png" DisplayAltText="NowPlaying" />
                        </Screenshots>
                      </DarkMode>
                      <LightMode>
                        <Screenshots>
                          <Screenshot Path="Assets\Screenshot-light.png" DisplayAltText="NowPlaying" />
                        </Screenshots>
                      </LightMode>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
